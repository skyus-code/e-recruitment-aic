APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Konfigurasi Email (SMTP)
# ---------------------------------------------------------------------------
# Pilih SALAH SATU skenario di bawah dengan menghapus tanda komentar (#).
#
# -- Skenario A — PRODUCTION (Gmail SMTP + App Password) --------------------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=alamat@gmail.com
# MAIL_PASSWORD=app_password_gmail_16_karakter
# MAIL_FROM_ADDRESS="alamat@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"
#
#   Cara mendapatkan App Password Gmail:
#   1. Aktifkan "2-Step Verification" di akun Google Anda.
#   2. Buka https://myaccount.google.com/apppasswords
#   3. Buat nama aplikasi (mis. "E-Recruitment Ar-Rahman"), klik Create.
#   4. Salin 16 karakter yang muncul (spasi boleh dihapus) ke MAIL_PASSWORD.
#
# -- Skenario B — DEVELOPMENT/TESTING (Mailtrap) ----------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_SCHEME=null
# MAIL_USERNAME=mailtrap_username
# MAIL_PASSWORD=mailtrap_password
# MAIL_FROM_ADDRESS="no-reply@arrahman.sch.id"
# MAIL_FROM_NAME="${APP_NAME}"
#
# Default lokal: email ditulis ke storage/logs/laravel.log (tidak dikirim).
MAIL_MAILER=log
# Pengaturan kode verifikasi dan reset kata sandi (nilai aman bawaan).
VERIFICATION_CODE_EXPIRES_MINUTES=10
VERIFICATION_CODE_RESEND_COOLDOWN=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_SEND_PER_HOUR=5
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@arrahman.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# OAuth Sosial (login dengan Google / LinkedIn / Facebook)
# ---------------------------------------------------------------------------
# Redirect URI yang didaftarkan di dashboard provider harus sama persis:
#   Google   : http://localhost:8000/auth/google/callback
#   LinkedIn : http://localhost:8000/auth/linkedin/callback
#   Facebook : http://localhost:8000/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=/auth/linkedin/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=/auth/facebook/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
